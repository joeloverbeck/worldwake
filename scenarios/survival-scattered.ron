// Adversarial survival scenario for Worldwake.
//
// Purpose: prove that agents can maintain basic needs under realistic adversity:
// spatially separated resources, travel metabolism costs, and isolated starting
// positions.  Tier 2 stress-test above survival-baseline.
//
// Key design constraints vs baseline:
// - No single location has food + water + wash
// - Travel costs metabolism (fatigue, thirst, bladder accumulate in transit)
// - Wilderness relief creates dirtiness (forces wash travel)
// - One agent (B) starts isolated from any resource
// - Max travel cost 7 ticks (vs baseline's 6) with more places (6 vs 4)
(
    seed: 205005,
    survival_health_contract: (
        max_authored_critical_run_ticks: 550,
        max_idle_window_ticks_with_elevated_need: 50,
        elevated_need_floor: 300,
        required_self_care_families: [Eat, Drink, Sleep, Relieve, Wash],
    ),
    places: [
        (name: "Hilltop Camp", tags: [Camp, Latrine]),
        (name: "Woodland Clearing", tags: [Forest]),
        (name: "Ravine Shelter", tags: [Camp, Latrine]),
        (name: "River Crossing", tags: [Crossroads, Road]),
        (name: "Orchard Hollow", tags: [Farm, Field]),
        (name: "Lowland Farm", tags: [Farm, Field]),
    ],
    edges: [
        (from: "Hilltop Camp", to: "Woodland Clearing", travel_ticks: 3, bidirectional: true),
        (from: "Ravine Shelter", to: "Woodland Clearing", travel_ticks: 4, bidirectional: true),
        (from: "Woodland Clearing", to: "River Crossing", travel_ticks: 3, bidirectional: true),
        (from: "Woodland Clearing", to: "Orchard Hollow", travel_ticks: 3, bidirectional: true),
        (from: "River Crossing", to: "Lowland Farm", travel_ticks: 3, bidirectional: true),
        (from: "Orchard Hollow", to: "Lowland Farm", travel_ticks: 5, bidirectional: true),
        (from: "Hilltop Camp", to: "River Crossing", travel_ticks: 6, bidirectional: true),
    ],
    agents: [
        (
            name: "Agent A",
