// Contested survival scenario for Worldwake.
//
// Purpose: prove that 4 AI agents can survive 1440 ticks under tight resource
// contention, dynamic depletion, and chokepoint topology — using only the
// profile set already exercised by `survival-baseline.ron` and
// `survival-scattered.ron`.  Tier 3 stress-test above `survival-scattered`.
//
// Key design constraints vs scattered:
// - 4 agents (vs 3) create real rivalry at capacity-4 wells.
// - Two water sources force belief invalidation when one is depleted mid-plan.
// - Wash co-located with one well (Spring Basin) doubles contention at that node.
// - Chokepoint hub (Central Crossing) must be traversed for cross-camp resources.
// - No new profiles: same profile set as baseline / scattered.  No
//   DiversificationProfile, ObligationSatiationProfile, ArtifactPostingProfile,
//   or DisposalProfile.
// - Starting needs aligned so that all four agents reach moderate thirst
//   pressure within a ~150-tick window, creating overlap at water sources.
(
    seed: 306006,
    survival_health_contract: (
        // Tightened from 400 to 300 by S116 (Drive Escalation Under Sustained
        // Critical Need). Motive-score escalation interrupts the wash-cycle
        // priority-override that previously allowed critical runs up to ~372
        // ticks empirically. The 300-tick default gives >=72 ticks of headroom
        // over the pre-S116 worst case while not depending on resolving the
        // `wash_preconditions` water-possession bottleneck
        // (`needs_actions.rs:196` still requires directly possessed Water).
        // Further tightening toward 200 requires a follow-up spec that changes
        // acquire-water-for-wash precedence or the wash precondition itself.
        max_authored_critical_run_ticks: 300,
        max_idle_window_ticks_with_elevated_need: 40,
        elevated_need_floor: 300,
        required_self_care_families: [Eat, Drink, Sleep, Relieve],
        critical_run_limits: (
            dirtiness: 1300,
        ),
    ),
    places: [
        (name: "North Camp", tags: [Camp, Latrine]),
        (name: "South Camp", tags: [Camp, Latrine]),
        (name: "Forest Glade", tags: [Forest]),
        (name: "Central Crossing", tags: [Crossroads, Road]),
        (name: "Stone Well", tags: [Crossroads]),
        (name: "Spring Basin", tags: [Crossroads]),
        (name: "East Orchard", tags: [Farm, Field]),
        (name: "West Grainfield", tags: [Farm, Field]),
    ],
    edges: [
        (from: "North Camp", to: "Stone Well", travel_ticks: 3, bidirectional: true),
        (from: "North Camp", to: "Forest Glade", travel_ticks: 2, bidirectional: true),
        (from: "South Camp", to: "Spring Basin", travel_ticks: 3, bidirectional: true),
        (from: "South Camp", to: "Forest Glade", travel_ticks: 2, bidirectional: true),
        (from: "Stone Well", to: "Central Crossing", travel_ticks: 2, bidirectional: true),
        (from: "Spring Basin", to: "Central Crossing", travel_ticks: 2, bidirectional: true),
        (from: "Central Crossing", to: "East Orchard", travel_ticks: 3, bidirectional: true),
        (from: "Central Crossing", to: "West Grainfield", travel_ticks: 3, bidirectional: true),
        (from: "East Orchard", to: "West Grainfield", travel_ticks: 4, bidirectional: true),
        (from: "Forest Glade", to: "Central Crossing", travel_ticks: 3, bidirectional: true),
    ],
    agents: [
        (
            name: "Agent A",
            location: "North Camp",
