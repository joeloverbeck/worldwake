// CLI evaluation scenario for Worldwake.
//
// 5 places, 6 travel edges (mix of bidirectional and unidirectional),
// 4 agents (1 human, 3 AI) with diverse profiles, items, facilities,
// and resource sources.  Designed to exercise all CLI commands.
//
// Updated 2026-04-05: Added bounty_posting_weight and notice_posting_weight to all UtilityProfiles (S51ARTISS-001).
//   Tuned Guard Theron as an explicit posting-capable showcase agent (S51ARTISS-004).
//   Added Forge at Hearthstone Inn and Medicine/Bow items for commodity variety.
// Updated 2026-04-03: S44 — Added universal and role-specific profiles to exercise
//   agent diversity: perception, tell, reasoning, communication, drive thresholds,
//   metabolism, patrol, pursuit, justice, theft, commodity valuation, facility queue.
// Updated 2026-04-04: S44-generalized-contention-substrate — Renamed
//   facility_queue_disposition → contention_disposition. Added missing profiles:
//   epistemic_disposition, intention_disposition, preference_profile, carry_capacity,
//   violation_disposition, substitute_preferences across agents.
(
    seed: 7777,
    places: [
        (name: "Thornwall Village", tags: [Village, Store]),
        (name: "Eldergrove Forest", tags: [Forest]),
        (name: "Dusty Trail", tags: [Trail]),
        (name: "Hearthstone Inn", tags: [Inn]),
        (name: "Golden Fields", tags: [Field, Farm]),
    ],
    edges: [
        // Village hub connections
        (from: "Thornwall Village", to: "Eldergrove Forest", travel_ticks: 3, bidirectional: true),
        (from: "Thornwall Village", to: "Dusty Trail", travel_ticks: 2, bidirectional: true),
        (from: "Thornwall Village", to: "Hearthstone Inn", travel_ticks: 4, bidirectional: true),
        (from: "Thornwall Village", to: "Golden Fields", travel_ticks: 5, bidirectional: true),
        // One-way shortcut from forest to trail (downhill path)
        (from: "Eldergrove Forest", to: "Dusty Trail", travel_ticks: 2, bidirectional: false),
        // Long route between outlying places
        (from: "Hearthstone Inn", to: "Golden Fields", travel_ticks: 8, bidirectional: true),
    ],
    agents: [
        // Human-controlled protagonist at village — sharp-eyed, trusts alarms
        (
            name: "Kael",
            location: "Thornwall Village",
            control: Human,
            needs: (
                hunger: 500,
                thirst: 300,
                fatigue: 100,
                bladder: 100,
                dirtiness: 100,
            ),
            utility_profile: (
                hunger_weight: 500,
                thirst_weight: 500,
                fatigue_weight: 500,
                bladder_weight: 500,
                dirtiness_weight: 500,
                pain_weight: 500,
                danger_weight: 500,
                enterprise_weight: 500,
                social_weight: 500,
                activity_awareness_weight: 500,
                side_benefit_weight: 500,
                bounty_posting_weight: 0,
                notice_posting_weight: 0,
                courage: 500,
                care_weight: 500,
            ),
            perception_profile: (
                memory_capacity: 16,
                memory_retention_ticks: 64,
                observation_fidelity: 950,
                confidence_policy: (
                    direct_observation_base: 900,
                    report_base: 700,
                    rumor_base: 400,
                    inference_base: 500,
                    report_chain_penalty: 100,
                    rumor_chain_penalty: 150,
                    staleness_penalty_per_tick: 2,
                ),
                institutional_memory_capacity: 20,
                consultation_speed_factor: 500,
                contradiction_tolerance: 300,
            ),
            communication_profile: (
                alarm_acceptance: 990,
                testimony_acceptance: 850,
                gossip_acceptance: 600,
            ),
            epistemic_disposition: (
                stale_evidence_barrier_threshold: 400,
                witness_query_duration_ticks: 2,
                ask_memory_retention_ticks: 12,
            ),
            carry_capacity: 50,
        ),
        // AI merchant at village — talkative, skeptical of gossip, thoughtful planner
        (
            name: "Merchant Vara",
            location: "Thornwall Village",
            control: Ai,
            needs: (
                hunger: 200,
                thirst: 200,
                fatigue: 100,
                bladder: 100,
                dirtiness: 100,
            ),
            utility_profile: (
                hunger_weight: 300,
                thirst_weight: 300,
                fatigue_weight: 200,
                bladder_weight: 200,
                dirtiness_weight: 200,
                pain_weight: 400,
                danger_weight: 600,
                enterprise_weight: 800,
                social_weight: 400,
                activity_awareness_weight: 300,
                side_benefit_weight: 500,
                bounty_posting_weight: 0,
                notice_posting_weight: 0,
                courage: 300,
                care_weight: 200,
            ),
            merchandise_profile: (
                sale_kinds: [Grain, Apple, Bread],
                home_facility: "Thornwall Village",
            ),
            trade_disposition: (
                negotiation_round_ticks: 2,
                initial_offer_bias: 600,
                concession_rate: 100,
                rejection_escalation_rate: 200,
                demand_memory_retention_ticks: 50,
                market_presence_ticks: 30,
            ),
            tell_profile: (
                max_tell_candidates: 5,
                max_relay_chain_len: 4,
                conversation_memory_capacity: 16,
                conversation_memory_retention_ticks: 64,
            ),
            communication_profile: (
                alarm_acceptance: 950,
                testimony_acceptance: 800,
                gossip_acceptance: 350,
            ),
            cognitive_profile: (
                max_candidates_to_plan: 4,
                max_plan_depth: 10,
                switch_margin: 100,
                transient_block_ticks: 20,
                unknown_block_ticks: 5,
                structural_block_ticks: 200,
                initial_cooldown_ticks: 4,
                max_cooldown_ticks: 64,
            ),
            execution_budget: (
                snapshot_travel_horizon: 6,
                max_prerequisite_locations: 3,
                max_node_expansions: 300,
                beam_width: 10,
            ),
            commodity_valuation: (
                recipe_opportunity_depth: 2,
                recipe_place_horizon: 3,
                indirect_value_decay_per_step: 300,
            ),
            contention_disposition: (
                queue_patience_ticks: Some(30),
            ),
            substitute_preferences: (
                preferences: { Food: [Grain, Apple, Bread] },
            ),
        ),
        // AI forager in the forest — dehydrates fast, urgent thirst, tempted by theft
        (
            name: "Forager Lina",
            location: "Eldergrove Forest",
            control: Ai,
            needs: (
                hunger: 200,
                thirst: 600,
                fatigue: 100,
                bladder: 100,
                dirtiness: 100,
            ),
            utility_profile: (
                hunger_weight: 600,
                thirst_weight: 700,
                fatigue_weight: 300,
                bladder_weight: 200,
                dirtiness_weight: 200,
                pain_weight: 500,
                danger_weight: 400,
                enterprise_weight: 400,
                social_weight: 300,
                activity_awareness_weight: 500,
                side_benefit_weight: 500,
                bounty_posting_weight: 0,
                notice_posting_weight: 0,
                courage: 400,
                care_weight: 300,
            ),
            drive_thresholds: (
                hunger: (low: 250, medium: 500, high: 750, critical: 900),
                thirst: (low: 100, medium: 300, high: 550, critical: 750),
                fatigue: (low: 300, medium: 550, high: 800, critical: 920),
                bladder: (low: 350, medium: 600, high: 800, critical: 930),
                dirtiness: (low: 400, medium: 650, high: 850, critical: 950),
                pain: (low: 150, medium: 350, high: 600, critical: 850),
                danger: (low: 100, medium: 300, high: 550, critical: 800),
            ),
            metabolism_profile: (
                hunger_rate: 2,
                thirst_rate: 5,
                fatigue_rate: 2,
                bladder_rate: 4,
                dirtiness_rate: 1,
                rest_efficiency: 20,
                starvation_tolerance_ticks: 480,
                dehydration_tolerance_ticks: 180,
                exhaustion_collapse_ticks: 120,
                bladder_accident_tolerance_ticks: 40,
                toilet_ticks: 8,
                wash_ticks: 12,
                travel_fatigue_multiplier: 0,
                travel_thirst_multiplier: 0,
                travel_bladder_multiplier: 0,
                wilderness_relief_dirtiness_penalty: 0,
            ),
            preference_profile: (
                route_caution_weight: 400,
                source_trust_weight: 300,
                route_memory_capacity: 24,
                source_memory_capacity: 18,
                memory_retention_ticks: 400,
            ),
            theft_disposition: (
                steal_duration_ticks: 3,
                theft_motive_weight: 200,
                witness_risk_penalty: 400,
            ),
        ),
        // AI guard on the trail — brave, vigilant, patrols, pursues, enforces justice
        (
            name: "Guard Theron",
            location: "Dusty Trail",
            control: Ai,
            needs: (
                hunger: 300,
                thirst: 300,
                fatigue: 100,
                bladder: 100,
                dirtiness: 100,
            ),
            combat_profile: (
                wound_capacity: 900,
                incapacitation_threshold: 750,
                attack_skill: 600,
                guard_skill: 550,
                defend_bonus: 150,
                natural_clot_resistance: 400,
                natural_recovery_rate: 60,
                unarmed_wound_severity: 250,
                unarmed_bleed_rate: 120,
                unarmed_attack_ticks: 3,
                defend_stance_ticks: 10,
            ),
            utility_profile: (
                hunger_weight: 400,
                thirst_weight: 400,
                fatigue_weight: 300,
                bladder_weight: 200,
                dirtiness_weight: 200,
                pain_weight: 600,
                danger_weight: 800,
                enterprise_weight: 200,
                social_weight: 300,
                activity_awareness_weight: 400,
                side_benefit_weight: 500,
                bounty_posting_weight: 700,
                notice_posting_weight: 900,
                courage: 850,
                care_weight: 400,
            ),
            perception_profile: (
                memory_capacity: 16,
                memory_retention_ticks: 64,
                observation_fidelity: 950,
                confidence_policy: (
                    direct_observation_base: 900,
                    report_base: 700,
                    rumor_base: 400,
                    inference_base: 500,
                    report_chain_penalty: 100,
                    rumor_chain_penalty: 150,
                    staleness_penalty_per_tick: 2,
                ),
                institutional_memory_capacity: 20,
                consultation_speed_factor: 500,
                contradiction_tolerance: 300,
            ),
            drive_thresholds: (
                hunger: (low: 250, medium: 500, high: 750, critical: 900),
                thirst: (low: 200, medium: 450, high: 700, critical: 850),
                fatigue: (low: 300, medium: 550, high: 800, critical: 920),
                bladder: (low: 350, medium: 600, high: 800, critical: 930),
                dirtiness: (low: 400, medium: 650, high: 850, critical: 950),
                pain: (low: 200, medium: 450, high: 700, critical: 900),
                danger: (low: 200, medium: 500, high: 750, critical: 950),
            ),
            patrol_profile: (
                base_dwell_ticks: 5,
                dwell_vigilance_scale_ticks: 3,
                vigilance: 700,
                route_adaptation_sensitivity: 400,
                patrol_motive_weight: 600,
            ),
            patrol_route: (
                assigned_places: ["Dusty Trail", "Thornwall Village"],
            ),
            pursuit_profile: (
                min_location_confidence: 500,
                max_pursuit_travel_ticks: 8,
            ),
            intention_disposition: (
                domain_patience: { Travel: 15, Care: 20 },
                default_patience_ticks: 30,
                commitment_switch_margin: 200,
            ),
            violation_disposition: (
                investigation_duration_ticks: 3,
                violation_memory_retention_ticks: 100,
                investigation_motive_weight: 600,
                ownership_motive_bonus: 300,
            ),
            carry_capacity: 40,
            justice_disposition: (
                accusation_motive_weight: 700,
                fine_severity: 500,
            ),
        ),
    ],
    items: [
        // Coins on Kael for trading
        (commodity: Coin, quantity: 20, location: "Kael"),
        // Water on Kael for immediate needs
        (commodity: Water, quantity: 5, location: "Kael"),
        // Grain and bread at village store
        (commodity: Grain, quantity: 10, location: "Thornwall Village"),
        (commodity: Bread, quantity: 5, location: "Thornwall Village"),
        // Apples in the forest
        (commodity: Apple, quantity: 8, location: "Eldergrove Forest"),
        // Sword on Guard Theron
        (commodity: Sword, quantity: 1, location: "Guard Theron"),
        // Firewood at the inn
        (commodity: Firewood, quantity: 3, location: "Hearthstone Inn"),
        // Medicine at the inn (traveler aid station)
        (commodity: Medicine, quantity: 2, location: "Hearthstone Inn"),
        // Bow on Guard Theron (ranged weapon)
        (commodity: Bow, quantity: 1, location: "Guard Theron"),
    ],
    facilities: [
        (workstation: Mill, location: "Thornwall Village"),
        (workstation: Forge, location: "Hearthstone Inn"),
    ],
    resource_sources: [
        (commodity: Apple, location: "Eldergrove Forest", regeneration_ticks_per_unit: 2, capacity: 20),
    ],
)
