// Survival drive-escalation scenario for Worldwake.
//
// Purpose: land the roadmap's drive-escalation row as a real 1440-tick
// survival scenario. Two agents share one orchard and one wash-capable water
// source. The wash facility and the water source are co-located at Spring
// Basin, where both agents start; the orchard is two hops away through Central
// Crossing so washing always competes with staying near food once they leave
// the basin.
//
// Lawful competing affordances intentionally removed from setup:
// - no combat, trade, or social branches
// - no second food hub or long-distance water route
// - no second camp or alternate local food source
// - fatigue pressure is downweighted, while thirst remains secondary but
//   reachable so the survival contract can still exercise Drink
//
// This keeps the scenario focused on the motive-priority branch:
// hunger_weight=1000 still beats dirtiness_weight=625 until sustained critical
// exposure raises Wash high enough to win, while the thirst rate keeps Drink
// reachable as its own water lifecycle instead of being hidden by apples.
(
    seed: 116006,
    survival_health_contract: (
        max_authored_critical_run_ticks: 250,
        max_idle_window_ticks_with_elevated_need: 60,
        elevated_need_floor: 300,
        required_self_care_families: [Eat, Drink, Sleep, Relieve, Wash],
        critical_run_limits: (
            hunger: 800,
            thirst: 800,
            dirtiness: 1300,
        ),
    ),
    places: [
        (name: "Central Crossing", tags: [Crossroads, Road]),
        (name: "Spring Basin", tags: [Crossroads]),
        (name: "East Orchard", tags: [Farm, Field]),
    ],
    edges: [
        (from: "Central Crossing", to: "Spring Basin", travel_ticks: 2, bidirectional: true),
        (from: "Central Crossing", to: "East Orchard", travel_ticks: 2, bidirectional: true),
    ],
    agents: [
        (
            name: "Agent A",
            location: "Spring Basin",
            control: Ai,
            known_recipes: ["Harvest Apples", "Harvest Water"],
            needs: (
