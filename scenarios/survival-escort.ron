// Survival escort scenario for Worldwake.
//
// Purpose: keep one caregiver's survival loop alive while a wounded ward is
// moved away from an active attacker. The owned branch is coordinated travel:
// observe a wounded co-located ward, select EscortToSafety, commit
// escort_to_safety, and end with both caregiver and ward at the clinic.
//
// Lawful competing affordances intentionally constrained:
// - one caregiver owns the survival-health envelope; the ward and attacker are
//   supporting causal actors
// - no medicine is locally authored, so in-place TreatWounds is not an
//   immediately actionable replacement for escort
// - food and water exist at both places so the proof is escort/care under
//   survival pressure rather than starvation pathfinding
(
    seed: 940216,
    // S178: this scenario proves coordinated care travel, not food spoilage. Its
    // agents rely on durable starting food stock (they do not replenish under
    // hunger pressure here — see tickets/AGEFOOREP-001.md), so it opts out of the
    // default Apple perish profile to preserve its pre-S178 survival contract. An
    // empty map means no commodity perishes.
    commodity_perish_profile: {},
    survival_health_contract: (
        max_authored_critical_run_ticks: 190,
        max_idle_window_ticks_with_elevated_need: 80,
        elevated_need_floor: 300,
        required_self_care_families: [Eat, Drink, Sleep, Relieve, Wash],
    ),
    places: [
        (name: "Roadside Camp", tags: [Forest, Camp, Latrine]),
        (name: "Village Clinic", tags: [Village, Camp, Latrine]),
    ],
    edges: [
        (from: "Roadside Camp", to: "Village Clinic", travel_ticks: 3, bidirectional: true),
