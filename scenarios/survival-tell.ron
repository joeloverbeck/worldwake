// Survival tell scenario for Worldwake.
//
// Purpose: land the roadmap's tell / peer info transfer row inside a real
// 1440-tick survival scenario. One scout starts at the only food-producing
// orchard and learns it by direct observation, but must return to camp for
// water, washing, sleep, and relief. A hungry listener starts at the camp
// without any direct line to the orchard. The landing is valid only if the
// scout relays that food belief before the listener first reaches the orchard.
//
// Lawful competing affordances intentionally constrained:
// - no second food source, no social-record systems, and no institutional facts
// - no local food at camp, so later orchard travel must be justified by remote
//   knowledge rather than a same-place fallback
// - the seed and starting needs are tuned so the scout returns to camp quickly
//   enough to speak before the listener's first orchard arrival
(
    seed: 417005,
    survival_health_contract: (
        max_authored_critical_run_ticks: 220,
        max_idle_window_ticks_with_elevated_need: 65,
        elevated_need_floor: 300,
        required_self_care_families: [Eat, Drink, Sleep, Relieve, Wash],
        critical_run_limits: (
            dirtiness: 700,
        ),
    ),
    places: [
        (name: "Rill Camp", tags: [Camp, Latrine]),
        (name: "North Orchard", tags: [Farm, Field]),
    ],
    edges: [
        (from: "Rill Camp", to: "North Orchard", travel_ticks: 2, bidirectional: true),
    ],
    agents: [
        (
            name: "Scout Una",
            location: "North Orchard",
            control: Ai,
